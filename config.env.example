# ============================================================
# Arma Reforger Panel — Aumik Edition Configuration Template
# Copy this file:  cp config.env.example config.env
# Then fill in your values.
# ============================================================

# Bcrypt hash of your panel admin password. The install script generates this
# automatically. To set/rotate it manually:
#   pip install bcrypt
#   python3 -c 'import bcrypt,getpass; \
#     print(bcrypt.hashpw(getpass.getpass().encode(), bcrypt.gensalt()).decode())'
PANEL_PASSWORD_HASH=

# Legacy plaintext password — only used if PANEL_PASSWORD_HASH is empty.
# Keep this empty in production; install.sh will hash it for you on first run.
# PANEL_PASSWORD=

# Port the panel listens on
PANEL_PORT=8888

# Path to your Arma Reforger server binary directory
SERVER_DIR=/home/arma/server

# Full path to your server config.json
SERVER_CONFIG=/home/arma/server/config.json

# Arma Reforger log directory (where logs_<timestamp>/console.log lives)
LOG_DIR=/home/arma/.config/ArmaReforger/logs

# Where the Reforger server downloads workshop addons. The panel scans the
# addon metadata and resource databases here for scenario IDs.
WORKSHOP_DIR=/home/arma/.local/share/Arma Reforger/addons

# Reforger profile directory. Session saves are written under
# `<PROFILE_DIR>/.save/{game,playersave,settings}/`. The Persistence card in
# the panel scans and flushes saves here. Defaults to
# `<parent-of-LOG_DIR>/profile` if left unset.
PROFILE_DIR=/home/arma/.config/ArmaReforger/profile

# Server FPS cap (passed as -maxFPS argument on startup)
# Leave blank to disable
MAX_FPS=60

# Optional game-side exporter JSON for player ping.
# FPS uses native -logStats output automatically. See README for the ping schema.
# GAME_TELEMETRY_FILE=/home/arma/server/telemetry.json

# Optional RCON overrides for the connected-player dropdown. By default the
# panel reads the server config's rcon block; 0.0.0.0 becomes 127.0.0.1 locally.
# Enable RCON on the game server first (see README).
# RCON_HOST=127.0.0.1
# RCON_PORT=19999
# RCON_PASSWORD=

# Accounts, presets and activity history. Defaults to this panel directory.
# Back this file up along with config.env and .panel-secret.
# PANEL_DATA_FILE=/home/arma/panel/.panel-data.sqlite3
